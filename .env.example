# Токен бота от @BotFather
BOT_TOKEN=

# Канал, куда публикуются готовые посты.
# Публичный канал: @my_channel
# Приватный канал: числовой id вида -1001234567890 (бот должен быть в нём админом с правом постить)
TARGET_CHANNEL_ID=

# Telegram user id тех, кому разрешено пользоваться ботом и нажимать кнопки публикации.
# Через запятую, например: 111111111,222222222
# Если оставить пустым — бот будет доступен всем, кто может ему написать (не рекомендуется).
ADMIN_IDS=

# Ключ Anthropic API (console.anthropic.com) — используется для рерайта и перевода
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Ключ Pexels API (pexels.com/api) — используется для подбора фото
PEXELS_API_KEY=
