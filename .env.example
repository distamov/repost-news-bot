# Токен бота от @BotFather
BOT_TOKEN=

# Каналы публикации. Для каждого — свой блок CHANNEL_N_* (N = 1, 2, 3, ...):
#   ID        — @username (публичный) или числовой id вида -1001234567890
#               (приватный; бот должен быть в нём админом с правом постить)
#   LABEL     — как канал будет называться в кнопке выбора в Telegram
#   LANG      — ru или uz (на каком языке готовить пост для этого канала)
#   SIGNATURE — подпись/ссылка в конце поста именно для этого канала
# Если канал один — бот сразу готовит пост для него, ничего не спрашивая.
# Если каналов несколько — перед рерайтом бот спросит, для какого канала
# готовить конкретный пост.
CHANNEL_1_ID=
CHANNEL_1_LABEL=
CHANNEL_1_LANG=uz
CHANNEL_1_SIGNATURE=

# CHANNEL_2_ID=
# CHANNEL_2_LABEL=
# CHANNEL_2_LANG=ru
# CHANNEL_2_SIGNATURE=

# Telegram user id тех, кому разрешено пользоваться ботом и нажимать кнопки публикации.
# Через запятую, например: 111111111,222222222
# Если оставить пустым — бот будет доступен всем, кто может ему написать (не рекомендуется).
ADMIN_IDS=

# Ключ Gemini API (aistudio.google.com/apikey) — используется для рерайта
# и перевода. Бесплатный тариф Gemini API — это не то же самое, что подписка
# Gemini Advanced/Google One: ключ берётся отдельно, по обычному
# Google-аккаунту, без привязки карты.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Ключ Pexels API (pexels.com/api) — используется для подбора фото
PEXELS_API_KEY=

# Необязательный второй источник фото — pixabay.com/api/docs (бесплатно,
# регистрация без карты). Если не задан, поиск идёт только по Pexels.
PIXABAY_API_KEY=

# --- Автомониторинг каналов-источников (опционально) ---
# Без этого блока бот работает только в ручном режиме (/rewrite).

# API_ID и API_HASH обычного Telegram-аккаунта, с my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Строка сессии, полученная один раз через scripts/telethon_login.py
TELEGRAM_SESSION=

# Каналы-источники через запятую: @channel1,@channel2 (или числовые id)
SOURCE_CHANNELS=

# Куда слать превью новых постов на модерацию: id группы/чата.
# Если не задано — превью уходят в личку каждому из ADMIN_IDS.
MODERATION_CHAT_ID=
