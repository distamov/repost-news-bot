# Токен бота от @BotFather
BOT_TOKEN=

# Канал, куда публикуются готовые посты.
# Публичный канал: @my_channel
# Приватный канал: числовой id вида -1001234567890 (бот должен быть в нём админом с правом постить)
TARGET_CHANNEL_ID=

# Telegram user id тех, кому разрешено пользоваться ботом и нажимать кнопки публикации.
# Через запятую, например: 111111111,222222222
# Если оставить пустым — бот будет доступен всем, кто может ему написать (не рекомендуется).
ADMIN_IDS=

# Ключ Gemini API (aistudio.google.com/apikey) — используется для рерайта
# и перевода. Бесплатный тариф Gemini API — это не то же самое, что подписка
# Gemini Advanced/Google One: ключ берётся отдельно, по обычному
# Google-аккаунту, без привязки карты.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Ключ Pexels API (pexels.com/api) — используется для подбора фото
PEXELS_API_KEY=

# --- Автомониторинг каналов-источников (опционально) ---
# Без этого блока бот работает только в ручном режиме (/rewrite).

# API_ID и API_HASH обычного Telegram-аккаунта, с my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Строка сессии, полученная один раз через scripts/telethon_login.py
TELEGRAM_SESSION=

# Каналы-источники через запятую: @channel1,@channel2 (или числовые id)
SOURCE_CHANNELS=

# Куда слать превью новых постов на модерацию: id группы/чата.
# Если не задано — превью уходят в личку каждому из ADMIN_IDS.
MODERATION_CHAT_ID=
